/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: SAMEORIGIN

/portal/*
  Cache-Control: no-cache

# Self-hosted libraries live in versioned folders (e.g. fontawesome-6.5.1), so they never change.
/assets/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/assets/img/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

# JS/CSS URLs carry ?v=<content hash> (scripts/build.mjs), so they can be cached for good.
/assets/css/*
  Cache-Control: public, max-age=31536000, immutable

/assets/js/*
  Cache-Control: public, max-age=31536000, immutable

/llms.txt
  Content-Type: text/plain; charset=utf-8

# One shared service worker serves the installable apps (/portal/, /admin/).
/assets/js/pwa-sw.js
  Service-Worker-Allowed: /

/portal/manifest.webmanifest
  Content-Type: application/manifest+json
