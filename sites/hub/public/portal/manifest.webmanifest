{
  "id": "/portal/",
  "name": "ProfJero Client Portal",
  "short_name": "ProfJero",
  "description": "Your bookings, quotes, projects, invoices and chat with ProfJero Hub, in one app.",
  "start_url": "/portal/?source=pwa",
  "scope": "/portal/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#F6F8FC",
  "theme_color": "#0A60EE",
  "categories": ["business", "productivity"],
  "icons": [
    { "src": "/assets/img/brand/app-portal-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/assets/img/brand/app-portal-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/assets/img/brand/app-portal-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "New booking", "url": "/booking/", "icons": [{ "src": "/assets/img/brand/app-portal-192.png", "sizes": "192x192" }] },
    { "name": "Messages", "url": "/portal/#/messages", "icons": [{ "src": "/assets/img/brand/app-portal-192.png", "sizes": "192x192" }] },
    { "name": "Quotes & orders", "url": "/portal/#/orders", "icons": [{ "src": "/assets/img/brand/app-portal-192.png", "sizes": "192x192" }] }
  ]
}
